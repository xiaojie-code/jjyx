# Server
PORT=3001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=competitive_game

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=*

# SMS gateway for recharge activation codes
SMS_API_URL=https://gyytz.market.alicloudapi.com/sms/smsSend
SMS_APPCODE=
SMS_TEMPLATE_ID=908e94ccf08b4476ba6c876d13f084ad
SMS_SIGN_ID=2e65b1bb3d054466b82f0c9d125465e2
SMS_CODE_MINUTE=5

# Android vendor push
ANDROID_PACKAGE_NAME=com.example.app
PUSH_XIAOMI_APP_SECRET=
PUSH_XIAOMI_PACKAGE_NAME=com.example.app
PUSH_HUAWEI_APP_ID=
PUSH_HUAWEI_CLIENT_ID=
PUSH_HUAWEI_CLIENT_SECRET=
PUSH_HONOR_APP_ID=
PUSH_HONOR_CLIENT_ID=
PUSH_HONOR_CLIENT_SECRET=
PUSH_OPPO_APP_KEY=
PUSH_OPPO_MASTER_SECRET=
PUSH_VIVO_APP_ID=
PUSH_VIVO_APP_KEY=
PUSH_VIVO_APP_SECRET=
PUSH_MEIZU_APP_ID=
PUSH_MEIZU_APP_SECRET=
