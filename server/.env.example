# Server
PORT=3001
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password
DB_DATABASE=competitive_game

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=*

# Tencent Cloud TRTC
TENCENT_TRTC_SDK_APP_ID=
TENCENT_TRTC_SECRET_KEY=
TENCENT_TRTC_USER_SIG_EXPIRE_SECONDS=86400
MEETING_MEDIA_MODE=trtc

# SMS gateway for recharge activation codes
SMS_API_URL=https://gyytz.market.alicloudapi.com/sms/smsSend
SMS_APPCODE=
SMS_TEMPLATE_ID=6f81fbc375f844c9b3084ff65257fe3a
SMS_SIGN_ID=8660ad50672642b297296cc7851781c4
SMS_TEMPLATE_PARAM_KEY=yzmCode
# Password reset SMS uses a separately approved template.
SMS_PASSWORD_RESET_TEMPLATE_ID=
SMS_PASSWORD_RESET_PARAM_KEY=newPassword
SMS_PASSWORD_RESET_SIGN_ID=

# Android vendor push
ANDROID_PACKAGE_NAME=com.example.app
PUSH_XIAOMI_APP_SECRET=
PUSH_XIAOMI_PACKAGE_NAME=com.example.app
PUSH_HUAWEI_APP_ID=
PUSH_HUAWEI_CLIENT_ID=
PUSH_HUAWEI_CLIENT_SECRET=
PUSH_HONOR_APP_ID=
PUSH_HONOR_CLIENT_ID=
PUSH_HONOR_CLIENT_SECRET=
PUSH_OPPO_APP_KEY=
PUSH_OPPO_MASTER_SECRET=
PUSH_VIVO_APP_ID=
PUSH_VIVO_APP_KEY=
PUSH_VIVO_APP_SECRET=
PUSH_MEIZU_APP_ID=
PUSH_MEIZU_APP_SECRET=
